# Expo Web: acesso direto à API, que já permite CORS.
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Dispositivo físico: IP do computador na mesma rede, diretamente na porta da API.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Android Emulator (API no computador):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Produção: endereço HTTPS da API, com CORS para o domínio web.
# EXPO_PUBLIC_API_URL=https://api.seu-dominio.com
